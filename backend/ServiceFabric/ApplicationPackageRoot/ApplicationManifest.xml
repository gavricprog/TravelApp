<?xml version="1.0" encoding="utf-8"?>
<ApplicationManifest ApplicationTypeName="TravelAppType"
                     ApplicationTypeVersion="1.0.0"
                     xmlns="http://schemas.microsoft.com/2011/01/fabric"
                     xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Parameters>
    <Parameter Name="UserService_InstanceCount" DefaultValue="-1" />
    <Parameter Name="TravelService_PartitionCount" DefaultValue="1" />
    <Parameter Name="TravelService_MinReplicaSetSize" DefaultValue="1" />
    <Parameter Name="TravelService_TargetReplicaSetSize" DefaultValue="1" />
    <Parameter Name="FinanceService_InstanceCount" DefaultValue="-1" />
  </Parameters>

  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="UserStatelessServicePkg" ServiceManifestVersion="1.0.0" />
    <ConfigOverrides />
  </ServiceManifestImport>

  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="TravelStatefulServicePkg" ServiceManifestVersion="1.0.0" />
    <ConfigOverrides />
  </ServiceManifestImport>

  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="FinanceStatelessServicePkg" ServiceManifestVersion="1.0.0" />
    <ConfigOverrides />
  </ServiceManifestImport>

  <DefaultServices>
    <Service Name="UserService">
      <StatelessService ServiceTypeName="UserStatelessServiceType" InstanceCount="[UserService_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>

    <Service Name="TravelService">
      <StatefulService ServiceTypeName="TravelStatefulServiceType"
                       TargetReplicaSetSize="[TravelService_TargetReplicaSetSize]"
                       MinReplicaSetSize="[TravelService_MinReplicaSetSize]">
        <UniformInt64Partition PartitionCount="[TravelService_PartitionCount]" LowKey="0" HighKey="9223372036854775807" />
      </StatefulService>
    </Service>

    <Service Name="FinanceService">
      <StatelessService ServiceTypeName="FinanceStatelessServiceType" InstanceCount="[FinanceService_InstanceCount]">
        <SingletonPartition />
      </StatelessService>
    </Service>
  </DefaultServices>
</ApplicationManifest>
